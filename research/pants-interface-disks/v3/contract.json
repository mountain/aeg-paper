  "identity": "allocate scope/role at leaf instantiation, before composition; pairwise disjoint ports/events; immutable sources may be shared only by caller-bound requests; no implicit copy, discard, slot swap or alpha identification",
  "residual": "complete gates, ports, internal bindings, external source records, nonzero obligations, replay trace and external boundary; recoverable lossless compression is allowed mathematically but not used by this wire format",
  "domain": "Q,P total over rational; R(u,w)=u/w only w!=0, u=1,t=4, therefore x+y!=0; never projectively continue or cancel domain guards",
  "composition": "disjoint union by stable role keys, add declared cross-operand bindings, recompute live boundary; retain all previous bindings and guards; no value-based identification; global DAG check after each join",
  "comparison": "same request: exact canonical structural/trace equality; distinct fresh requests: role-validated alpha normalization only, preserve source keys, ordered slots and all graph incidences",
  "refusal_conditions": [
    "caller request mismatch",
    "foreign same-value source",
    "source record or gate source changed",
    "unknown source",
    "duplicate/collapsed occurrence",
    "wrong scope/role",
    "boolean or wrong slot",
    "type mismatch",
    "missing/duplicate/multiple-producer binding",
    "unrecorded fanout or discard",
    "directed feedback",
    "missing production event",
    "partial residual or last-seam-only residual",
    "altered replay value",
    "missing/nonmatching nonzero guard",
    "division by zero",
    "wrong external boundary",
    "unbound input",
    "undeclared instance",
    "duplicate JSON keys",
    "evidence reordering or forged summary"
  ],
